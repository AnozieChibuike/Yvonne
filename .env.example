# Groq API. Keep the actual key private in .env.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Supabase server credentials. Use the service-role key only on this private server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated authorized WhatsApp numbers. LID identifiers may include the @lid suffix.
ALLOWED_NUMBERS=2340000000000

# Optional private web calendar links.
YVONNE_WEB_URL=https://yvonne-self.vercel.app

# Daily check-ins (24-hour local times)
CHECKIN_TIMEZONE=Africa/Lagos
CHECKIN_MORNING=07:00
CHECKIN_DAYTIME=13:00
CHECKIN_EVENING=21:00

# Optional Google Tasks support. Run `npm run auth` after configuring these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

LOG_LEVEL=info
